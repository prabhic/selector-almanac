{
  "name": "lev-selector-almanac",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Open-source searchable almanac of Lev Selector's weekly AI seminars",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/prabhic/selector-almanac.git"
  },
  "homepage": "http://prabhanjan.in/selector-almanac/app/",
  "scripts": {
    "ingest": "node scripts/ingest.mjs",
    "ingest:quick": "node scripts/ingest.mjs --quick",
    "ingest:all": "node scripts/ingest.mjs --all",
    "ingest:refresh": "node scripts/refresh-recent.mjs && npm run build",
    "ingest:refresh:parse": "node scripts/refresh-recent.mjs --parse && npm run build",
    "ingest:delta": "node scripts/ingest-new-decks.mjs && node scripts/refresh-recent.mjs --weeks 6 --parse && npm run build",
    "trends": "node scripts/build-trends.mjs",
    "index": "node scripts/build-index.mjs",
    "search:index": "node scripts/build-search-index.mjs",
    "search:embed": "node scripts/embed-search-vectors.mjs",
    "build": "npm run index && npm run search:index && npm run search:embed",
    "extract-mock": "node scripts/extract-mock-data.mjs",
    "serve": "npx --yes serve . -p 3456",
    "browse": "node scripts/browse-tui.mjs",
    "browse:open": "node scripts/open-browse-cmux.mjs",
    "browse:cli": "node scripts/browse-weeks.mjs"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "jszip": "^3.10.1",
    "neo-blessed": "^0.2.0"
  }
}
