{
  "name": "selector-almanac",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Open-source searchable almanac of Lev Selector's weekly AI seminars",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prabhic/selector-almanac.git"
  },
  "homepage": "http://prabhanjan.in/selector-almanac/app/",
  "bin": {
    "selector-almanac": "scripts/cli.mjs"
  },
  "files": [
    "app/",
    "data/*.json",
    "data/sessions/",
    "data/search/",
    "scripts/",
    "index.html",
    "ATTRIBUTION.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ingest": "node scripts/ingest.mjs",
    "ingest:quick": "node scripts/ingest.mjs --quick",
    "ingest:all": "node scripts/ingest.mjs --all",
    "ingest:refresh": "node scripts/refresh-recent.mjs && npm run build",
    "ingest:sync": "node scripts/sync-from-remote.mjs",
    "ingest:refresh:parse": "node scripts/refresh-recent.mjs --parse && npm run build",
    "ingest:delta": "node scripts/ingest-new-decks.mjs && node scripts/refresh-recent.mjs --weeks 6 --parse && npm run build",
    "ingest:decks": "node scripts/ingest-new-decks.mjs --skip-youtube && node scripts/refresh-recent.mjs --weeks 2 --parse --slides-only && npm run build",
    "restore:regressed": "node scripts/restore-regressed.mjs && npm run build",
    "compile": "node scripts/compile-sessions.mjs",
    "validate": "node scripts/validate-data.mjs",
    "test": "node scripts/test-weekly-filter.mjs",
    "probe:youtube": "node scripts/probe-youtube.mjs",
    "trends": "node scripts/build-trends.mjs",
    "index": "node scripts/build-index.mjs",
    "search:index": "node scripts/build-search-index.mjs",
    "search:embed": "node scripts/embed-search-vectors.mjs",
    "build": "npm run compile && npm run index && npm run search:index && npm run search:embed",
    "extract-mock": "node scripts/extract-mock-data.mjs",
    "serve": "npx --yes serve . -p 3456",
    "browse": "node scripts/browse-tui.mjs",
    "browse:open": "node scripts/open-browse-cmux.mjs",
    "browse:cli": "node scripts/browse-weeks.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "neo-blessed": "^0.2.0"
  },
  "devDependencies": {
    "@xenova/transformers": "^2.17.2"
  }
}
